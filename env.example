# Copia este archivo como ".env" y completa los valores reales.
# El archivo ".env" NO se sube a GitHub; este ejemplo sí.

# Genera una clave nueva con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# True solo en tu computador; en producción debe ser False
DJANGO_DEBUG=True

# Dominios permitidos, separados por coma
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Solo en producción, con https:// (separados por coma)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Vacío = usa SQLite local. En producción: postgres://usuario:clave@host:5432/base
DATABASE_URL=
